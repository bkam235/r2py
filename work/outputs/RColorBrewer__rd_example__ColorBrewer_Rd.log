    def display_brewer_pal(n, name):
        pal = brewer_pal(n, name)
        plt.figure(figsize=(6, 1))
        data = np.arange(1, n + 1).reshape(1, n)
        plt.imshow(data, aspect='auto', cmap=ListedColormap(pal), extent=[1, n, 1, 1])
        plt.xlabel(name)
        plt.yticks([])
        plt.xticks([])
        plt.gca().set_axis_off()
        plt.ylim(0.5, 1.5)
        plt.show()
    
