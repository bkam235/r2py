    def glance(fit):
        return pd.DataFrame({
            'edf': [fit.edf],
            'AIC': [fit.aic],
            'BIC': [fit.bic],
            'logLik': [fit.logLik],
            'nobs': [fit.nobs]
        })
    
    # Main execution flow
    print(glance(fit))

