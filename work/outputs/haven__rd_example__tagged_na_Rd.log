    def na_tag(x):
        if isinstance(x, (list, np.ndarray)):
            return np.array([i.tag if isinstance(i, TaggedNA) else None for i in x])
        if isinstance(x, TaggedNA):
            return x.tag
        return None
    res_tag = na_tag(x)
    out_tag = []
    for i in res_tag:
        if i is None:
            out_tag.append("NA")
        else:
            out_tag.append(f'"{i}"')
    print(f"[1] {' '.join(out_tag)}")

