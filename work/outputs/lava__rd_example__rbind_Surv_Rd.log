  Python:
    def surv_rbind(s1, s2):
        combined_data = np.vstack([s1.data, s2.data])
        new_obj = Surv.__new__(Surv)
        new_obj.data = combined_data
        new_obj.type = s1.type
        return new_obj
    
    # Data setup
    res1 = surv_rbind(S1_obj, S1_obj)
    print(res1)

