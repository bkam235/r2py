    def peek_vars(fn_name=None):
        x = vars_env["selected"]
        if x is None:
            name = f"`{fn_name}()`" if fn_name else "Selection helpers"
            raise RuntimeError(f"{name} must be used within a *selecting* function.")
        return x
    print(peek_vars())
    
