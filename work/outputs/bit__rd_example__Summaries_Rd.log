    def r_sum(x, range_val: Optional[list] = None):
        if isinstance(x, BitArray):
            data = x.data
            if range_val is not None:
                start = range_val[0] - 1
                end = range_val[1]
                return np.sum(data[start:end])
            return np.sum(data)
        
        if isinstance(x, pd.Series) and x.isna().any():
            return np.nan
        return np.sum(x)
