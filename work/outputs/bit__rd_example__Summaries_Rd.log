    def r_all(x, range_val: Optional[list] = None):
        # range_val is 1-indexed [start, end]
        data = x.data if isinstance(x, BitArray) else np.array(x, dtype=bool)
        if range_val is not None:
            start = range_val[0] - 1
            end = range_val[1]
            return np.all(data[start:end])
        return np.all(data)
    print(f"[1] {r_all(l)}")
    
