    def sequence(nvec, from_val=1, by=1, recycle=False):
        nvec = np.asarray(nvec, dtype=int)
        res = []
        for n in nvec:
            res.extend(range(from_val, from_val + n * by, by))
        return np.array(res)
    print(sequence([3, 4]))

