  Python:
    def date_time_parse(x, zone, format=None):
        # Parses string as naive then localizes to zone
        ts = pd.to_datetime(x)
        return ts.tz_localize(zone)
    x = date_time_parse("2019-01-02 01:30:00", "America/New_York")
    print(f'[{x.strftime("%Y-%m-%d %H:%M:%S %Z")}]')

