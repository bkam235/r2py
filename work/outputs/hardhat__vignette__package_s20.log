    def simple_lm(formula, data):
        model = ols(formula, data=data).fit()
        # Store blueprint and model for emulation of hardhat structure
        return {
            "model": model,
            "blueprint": formula,
            "data": data
        }
        model = simple_lm("bill_length_mm ~ body_mass_g + species", penguins)
    
