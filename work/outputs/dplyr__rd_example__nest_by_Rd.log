    def fit_lm(df):
        X = df[['wt']]
        y = df['mpg']
        return OLS(y, tools.add_constant(X)).fit()
    
    models_nested = nest_by(mtcars, 'cyl')
    models_nested['model'] = models_nested['data'].apply(fit_lm)
    models = models_nested

