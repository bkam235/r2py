    def tidy(m):
        return pd.DataFrame({
            'term': m.params.index,
            'estimate': m.params.values,
            'std.error': m.bse.values,
            'p.value': m.pvalues.values
        })
    
    tidy_list = models['model'].apply(tidy).tolist()
    reframe_tidy = pd.concat(tidy_list).reset_index(drop=True)
    print(reframe_tidy)
    
