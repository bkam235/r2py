  Python:
    for idx, row in data.iterrows():
        # Create diamond shape using an Ellipse
        diamond = Ellipse(
            xy=(row['x'], row['y']),
            width=0.2,  # radx * 2
            height=0.1, # rady * 2
            angle=row['angle'],
            edgecolor=plt.cm.tab10(row['color']/10),
            facecolor='none',
            linewidth=2
        )
        ax.add_patch(diamond)
        
        # Add text label
        ax.text(
            row['x'], row['y'], 
            row['label'], 
            ha='center', va='center', 
            fontsize=14, 
            rotation=row['angle']
        )
    
    plt.show()
