    def quo_text(quo_obj):
        """Returns the squashed expression as text."""
        squashed = quo_squash(quo_obj)
        # R's quo_text returns a character vector: [1] "foo(bar)"
        return f'[1] "{squashed}"'
    print(quo_text(quo_val))
    
