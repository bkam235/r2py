  Python:
    def glue_fixed(*args, **kwargs):
        """
        Mimics R's glue function with .trim=TRUE behavior.
        x: glue("\n  blah\n  ") -> "blah"
        y: glue("\n\n  blah\n\n  ") -> "\nblah\n"
        """
        text = "".join(str(arg) for arg in args)
        text = textwrap.dedent(text)
        if text.startswith('\n'):
            text = text[1:]
        if text.endswith('\n'):
            text = text[:-1]
        text = text.rstrip(' ')
        return text
    x = glue_fixed("""
      blah
      """)

