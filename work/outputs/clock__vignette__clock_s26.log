    grouped = x.floor("5min")
    grouped_str = [t.strftime("%Y-%m-%d %H:%M:%S UTC") for t in grouped]
    for i in range(0, len(grouped_str), 2):
        chunk = grouped_str[i:i+2]
        prefix = f" [{i+1}] " if i == 0 else f" [{i+1}] "
        line = " ".join([f'"{s}"' for s in chunk])
