  Python:
    def ps_is_supported():
        """Mimics ps::ps_is_supported()"""
        # In Python, psutil is generally supported if installed.
        # R's ps_is_supported checks for /proc/stat on Linux.
        if platform.system() == "Linux":
            try:
                with open("/proc/stat", "r") as f:
                    f.readline()
                return True
            except Exception:
                return False
        return True

