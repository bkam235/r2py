  Python:
    def ps_os_type():
        """Mimics ps::ps_os_type()"""
        system = platform.system()
        return {
            "POSIX": system in ("Linux", "Darwin"),
            "LINUX": system == "Linux",
            "MACOS": system == "Darwin",
            "WINDOWS": system == "Windows"
        }

