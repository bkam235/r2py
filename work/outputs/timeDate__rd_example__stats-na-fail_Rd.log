    def set_na(obj, indices):
        # R's is.na(td) <- 2:3
        # indices is usually a range like 2:3 -> [2, 3]
        for idx in indices:
            obj.data[idx - 1] = None
    # R: is.na(td) <- 2:3
    # Python doesn't support assignment to function calls.
    set_na(td, range(2, 4))

