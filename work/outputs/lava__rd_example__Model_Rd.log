        def __init__(self, formula):
            self.formula = formula
            self.M = [[0, 0], [1, 0]]
            self.par = [[None, None], [None, None]]
            self.cov = [[1, 0], [0, 1]]
            self.covpar = [[None, None], [None, None]]
            self.fix = [[None, None], [None, None]]
            self.covfix = [[None, None], [None, None]]
            self.latent = []
            self.mean = {'y': None, 'x': None}
            self.index = {
                'vars': ['y', 'x'], 
                'manifest': ['y', 'x'], 
                'exogenous': 'x', 
                'endogenous': 'y', 
                'exo.idx': 2, 
                'endo.obsidx': 1, 
