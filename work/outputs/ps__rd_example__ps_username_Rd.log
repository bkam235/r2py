    create_time = p.create_time()
    import datetime
    dt = datetime.datetime.fromtimestamp(create_time).strftime('%Y-%m-%d %H:%M:%S.%f')
    handle_str = f"<ps::ps_handle> PID={p.pid}, NAME={p.name()}, AT={dt}"
    
    username_val = p.username()
    print(handle_str)
    print(f'[1] "{username_val}"')
