  Python:
    def semester(x, with_year=False):
        months = x.month.values
        years = x.year.values
        # semesters <- rep(1:2, each = 6)
        semesters_map = [1]*6 + [2]*6
        s = np.array([semesters_map[m-1] for m in months])
        
        if with_year:
            return years + (s / 10.0)
        else:
            return s.astype(int)
    print(semester(x))

