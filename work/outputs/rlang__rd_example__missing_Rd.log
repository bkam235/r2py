    typeof(NA)
  Python:
    def typeof(x):
        if x is None:
            return "NULL"
        if isinstance(x, bool) or (isinstance(x, float) and np.isnan(x)):
            # In R, NA is logically a logical type by default
            return "logical"
        if isinstance(x, int):
            return "integer"
        if isinstance(x, float):
            return "double"
        return type(x).__name__
    
    # Define rlang-style NA aliases
    print(typeof(np.nan))

