    def sql_call2(fn, *args, con=None):
        """Mimics sql_call2 which constructs a SQL call."""
        expr_tuple = (fn, *args)
        res = replace_expr(expr_tuple, con=con)
        return sql(res)
    
    # Helper for R's %as% and %::%
    print(sql_call2("+", 'x', 1, con=con))
    
