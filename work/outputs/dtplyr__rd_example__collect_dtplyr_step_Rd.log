    def lazy_dt(x):
        """
        dtplyr provides a lazy interface to data.table. 
        In Python, we wrap the dataframe in a class that stores the operation 
        to mimic the lazy behavior of dtplyr.
        """
        class LazyDt:
            def __init__(self, data):
                self.data = pd.DataFrame(data)
                self.ops = []

