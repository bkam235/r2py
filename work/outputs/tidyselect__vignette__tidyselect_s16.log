        "cyl": [6, 6, 4, 6],
        "disp": [160.0, 160.0, 108.0, 244.0],
        "hp": [110, 110, 93, 110]
    }
    
    # R: eval_select(rlang::expr(c(foo = mpg)), mtcars)
    # In Python, c(foo = mpg) is represented as a dictionary {'foo': 'mpg'}
