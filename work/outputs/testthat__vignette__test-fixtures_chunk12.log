    withr::deferred_run()
  Python:
        def deferred_run(self):
            # Execute and clear the deferred events
            while self.global_exits:
                expr_func = self.global_exits.pop()
                expr_func()
    
    withr = WithrMock()
    
    # In R: withr::defer(print("hi"))
    # Python requires a callable for deferred execution
    withr.deferred_run()
