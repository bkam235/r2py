    class WithrMock:
        def __init__(self):
            self.global_exits = []
    
        def defer(self, expr_func, priority="first"):
            if priority == "first":
                self.global_exits.insert(0, expr_func)
            else:
                self.global_exits.append(expr_func)
    withr.defer(lambda: print("hi"))
    
