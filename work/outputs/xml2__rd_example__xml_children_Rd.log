  R:
    xml_parent(xml_children(x))
  Python:
    parents = []
    seen = set()
    for child in children:
        p = child.getparent()
        if p is not None and p not in seen:
            parents.append(p)
            seen.add(p)
    print_nodeset(parents)
    
