    def vec_c(*args):
        flat = []
        for arg in args:
            if isinstance(arg, (list, np.ndarray, pd.Series)):
                flat.extend(arg)
            else:
                if arg is not None:
                    flat.append(arg)
        return np.array(flat)
    x_flat = vec_c(*x)

