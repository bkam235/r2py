        def step_hyperbolic(self, terms, func="cosh", inverse=False):
            step_id = "hyperbolic_IhS7o" # Mimicking the R-generated ID
            self.steps.append({
                'terms': terms,
                'func': func,
                'inverse': inverse,
                'id': step_id,
                'columns': [] # filled during prep
            })
            return self

