  Python:
        def tidy(self, number=1):
            step = self.steps[number-1]
            # For prepped objects, tidy expands the terms to actual columns
            res = []
            for col in step['columns']:
                res.append({
                    'terms': col,
                    'inverse': step['inverse'],
                    'func': step['func'],
                    'id': step['id']
                })
            return pd.DataFrame(res)
    print(cos_obj.tidy(number=1))
