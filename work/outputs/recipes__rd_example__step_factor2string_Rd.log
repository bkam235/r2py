    def step_factor2string(recipe, column):
        step = {
            'subclass': 'factor2string',
            'terms': column,
            'role': None,
            'trained': False,
            'columns': column,
            'skip': False,
            'id': 'step_factor2string_1'
        }
        recipe.steps.append(step)
        return recipe

