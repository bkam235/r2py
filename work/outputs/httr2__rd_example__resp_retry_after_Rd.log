  Python:
    def resp_date(resp):
        date_str = resp.get_header("Date")
        return email.utils.parsedate_to_datetime(date_str)
    
    def resp_header(resp, name):
        return resp.get_header(name)
    
    def resp_retry_after(resp):
        val = resp_header(resp, "Retry-After")
        if val is None:
            return None # Equivalent to R's NA in this context
        
        if " " in val:
            # Parse HTTP date
            retry_date = email.utils.parsedate_to_datetime(val)
            resp_date_val = resp_date(resp)
            diff = (retry_date - resp_date_val).total_seconds()
            return float(diff)
        else:
            try:
                return float(val)
            except ValueError:
                return None
    
    def r_print(val):
        """Helper to mimic R's print output format [1] value"""
        if val is None:
            print("[1] NA")
        elif isinstance(val, float) and val.is_integer():
            print(f"[1] {int(val)}")
        else:
            print(f"[1] {val}")
    
    # Example 1
    res1 = resp_retry_after(resp)
    r_print(res1)
    
