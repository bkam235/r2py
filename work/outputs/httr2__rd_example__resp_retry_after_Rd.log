    class Response:
        def __init__(self, status_code=200, url="https://example.com", method="GET", headers=None, body=b"", timing=None):
            self.status_code = status_code
            self.url = url
            self.method = method
            # Convert string headers "K: V, K2: V2" to a dictionary
            if isinstance(headers, str):
                self.headers = {}
                for line in headers.split('\n'):
                    if ':' in line:
                        k, v = line.split(':', 1)
                        self.headers[k.strip()] = v.strip()
            elif headers is None:
                self.headers = {}
            else:
                self.headers = headers
            
            if 'Date' not in self.headers:
                # Mimic R's default date in the response() function
                self.headers['Date'] = "Wed, 01 Jan 2020 00:00:00 UTC"
            
            self.body = body
            self.timing = timing
    
        def get_header(self, name):
            # Case-insensitive lookup to mimic R's behavior
            for k, v in self.headers.items():
                if k.lower() == name.lower():
                    return v
            return None
    resp = Response(headers="Retry-After: 30")

