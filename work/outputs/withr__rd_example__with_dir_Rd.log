  R:
    with_dir(tempdir(), getwd())
  Python:
    def with_dir(new, code):
        old = os.getcwd()
        os.chdir(new)
        try:
            # In R, force(code) evaluates the expression and returns the result
            result = code()
            return result
        finally:
            os.chdir(old)
    temp_dir = tempfile.mkdtemp()
    res_with_dir = with_dir(temp_dir, getwd)
    print(f'[1] "{res_with_dir}"')
