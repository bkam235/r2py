    def env():
        """Returns a new empty environment."""
        return REnv(name="empty_env")
    
    def current_env():
        """Returns the simulated global environment."""
        if not hasattr(current_env, "_global"):
            current_env._global = REnv(name="R_GlobalEnv")
        return current_env._global
    default = env()

