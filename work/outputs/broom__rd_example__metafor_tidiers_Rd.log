  Python:
    def tidy(model):
        """Mimics broom::tidy for metafor rma objects"""
        return pd.DataFrame({
            'term': ['overall summary'],
            'type': ['summary'],
            'estimate': [model['beta']],
            'std.error': [model['se']],
            'statistic': [model['zval']],
            'p.value': [model['pval']]
        })
    
    # Execution
    result = tidy(meta_analysis)
    print(result)
