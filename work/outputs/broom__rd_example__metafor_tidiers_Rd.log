    df = df_input.copy()
    # For RR, yi = log( (ai/(ai+bi)) / (ci/(ci+di)) )
    # vi = 1/ai + 1/bi + 1/ci + 1/di
    df['yi'] = np.log(
        (df['tpos'] / (df['tpos'] + df['tneg'])) / 
        (df['cpos'] / (df['cpos'] + df['cneg']))
    )
    df['vi'] = (1.0 / df['tpos']) + (1.0 / df['tneg']) + (1.0 / df['cpos']) + (1.0 / df['cneg'])

