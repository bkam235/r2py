    paste3 <- function(out, input, sep = ".") {
      if (nchar(out) > 4) {
        return(done(out))
      }
      paste(out, input, sep = sep)
    }
  Python:
    def paste3(out, input_val, sep="."):
        if len(str(out)) > 4:
            return Done(out)
        return f"{out}{sep}{input_val}"

