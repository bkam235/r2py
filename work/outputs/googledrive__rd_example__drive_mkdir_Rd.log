    def pluck(x, *indices):
        curr = x
        try:
            for idx in indices:
                if isinstance(curr, list):
                    curr = curr[idx - 1]
                elif isinstance(curr, dict):
                    curr = curr[idx]
            return curr
        except (IndexError, KeyError):
            return None
    
