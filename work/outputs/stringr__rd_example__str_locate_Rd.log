  Python:
    def str_locate_all(text_list, pattern):
        results = []
        for text in text_list:
            matches = [(m.start() + 1, m.end()) for m in re.finditer(f'(?={pattern})' if pattern == "" else pattern, text)]
            results.append(matches)
        return results
    
    import numpy as np
    
    # str_locate(fruit, "$")
    print(str_locate_all(fruit, "a"))
    
