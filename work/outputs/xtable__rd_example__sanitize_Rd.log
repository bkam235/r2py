  R:
    as.math("x10^10", ": mathematical expression")
  Python:
    def as_math(str_val, *args):
        res = f"${str_val}$"
        for arg in args:
            res += str(arg)
        return res
    
    # Execution logic
    # insane <- c("&",">", ">","_","%","$","\\","#","^","~","{","}")
    res_amath = as_math("x10^10", ": mathematical expression")
    print(f'[1] "{res_amath}"')
