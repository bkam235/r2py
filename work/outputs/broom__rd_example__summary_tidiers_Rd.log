    def tidy(x):
        if isinstance(x, Summary):
            df = pd.DataFrame([x.stats_dict])
            if x.nas > 0:
                df['na'] = int(x.nas)
            df.index = [1]
            return df
        raise TypeError(f"No tidy method for objects of class {type(x)}")
    res_tidy = tidy(s)
    print(res_tidy)

