    def strip_style(text):
        ansi_escape = re.compile(r'\x1B(?:[@-Z\\].|[0-9-;]*[$-^YZ])')
        return ansi_escape.sub('', text)
    
    print(re.split(r"[-]+", strip_style(str_val)))

