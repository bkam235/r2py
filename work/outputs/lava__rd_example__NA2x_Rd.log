    def NA2x(s, x=0):
        """
        Translates to Python using pandas/numpy to replace NaNs with x.
        """
        s_arr = np.array(s)
        # Replace NaN values with x
        res = np.where(np.isnan(s_arr), x, s_arr)
        return res
    
    # Main script translation
    # R: x2NA(1:10, 1:5)
    res_x2na = x2NA(np.arange(1, 11), 5)
    print(NA2x(res_x2na, 5))
