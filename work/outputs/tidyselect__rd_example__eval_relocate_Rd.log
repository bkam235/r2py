  R:
    relocate <- function(.x, ..., .before = NULL, .after = NULL) {
      pos <- eval_relocate(
        expr(c(...)),
        .x,
        before = enquo(.before),
        after = enquo(.after)
      )
      set_names(.x[pos], names(pos))
    }
  Python:
    def relocate(df, *args, _before=None, _after=None):
        pos = eval_relocate(list(args), df, before=_before, after=_after)
        return df[pos]
    
