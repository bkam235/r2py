  R:
    uvar <- function(x, means = FALSE) {
      # if means = TRUE, the means and variances are returned, 
      # otherwise just the variances
      m <- colMeans(x)
      n <- nrow(x)
      x <- x - outer(rep(1,n),m)
      v <- colSums(x^2) / (n - 1)
      if (means) list(mean = m, var = v) else v
    }
  Python:
    def uvar(x, means=False):
        # x is expected to be a pandas DataFrame or numpy array
        if isinstance(x, pd.DataFrame):
            m = x.mean()
            v = x.var()
        else:
            m = np.mean(x, axis=0)
            v = np.var(x, axis=0, ddof=1)
            
        if means:
            return {"mean": m, "var": v}
        else:
            return v

