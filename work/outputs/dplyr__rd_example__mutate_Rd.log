  R:
    df |> mutate(z = x + y, .after = x)
  Python:
    res5_3 = df.assign(z = df['x'] + df['y'])
    cols5_3 = list(res5_3.columns)
    z_idx = cols5_3.index('z')
    val = cols5_3.pop(z_idx)
    cols5_3.insert(cols5_3.index('x') + 1, val)
    res5_3 = res5_3[cols5_3]
    print(res5_3)
    
