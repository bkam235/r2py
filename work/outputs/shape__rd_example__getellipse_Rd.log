    angles = np.arange(0, 182, 2)
    for i in angles:
        pts_loop = get_ellipse(0.5, 0.25, mid=(0.5, 0.5), angle_deg=i)
        # R: col[(i/2)+1] -> index is 1-based
        color_idx = int(i // 2)
        if color_idx < len(col):
            plt.plot(pts_loop[:, 0], pts_loop[:, 1], color=col[color_idx], linewidth=2)
    
    plt.axis('equal')
    plt.show()
