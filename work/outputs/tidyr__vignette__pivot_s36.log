  Python:
    print(f"# A tibble: {len(updates)} × {len(updates.columns)}")
    print(" county   date       system value")
    print(" <chr>    <date>     <chr>  <dbl>")
    # Format values to match R's print (stripping .0 from integers in dbl columns if needed, 
    # but updates' value column has floats, so we maintain decimal)
    for i in range(len(updates)):
        row = updates.iloc[i]
        # R's tibble print adds a row index on the left
        date_str = row['date'].strftime('%Y-%m-%d')
        val_str = f"{row['value']:.1f}".rstrip('0').rstrip('.') if row['value'] % 1 != 0 else f"{int(row['value'])}"
        # Re-evaluating based on R output: 4 is 4, 3.2 is 3.2
        val_fmt = f"{row['value']:g}"
        print(f"{i+1} {row['county']:<8} {date_str:<10} {row['system']:<8} {val_fmt}")
