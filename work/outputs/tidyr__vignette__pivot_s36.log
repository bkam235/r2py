    wake_dates = pd.to_datetime("2020-01-01") + pd.to_timedelta(np.arange(3), unit='D')
    guilford_dates = pd.to_datetime("2020-01-03") + pd.to_timedelta(np.arange(2), unit='D')
    all_dates = np.concatenate([wake_dates, guilford_dates])
    
