    def ansi_strip(text):
        """Removes ANSI escape sequences from a string."""
        ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[JKmn])')
        return ansi_escape.sub('', text)
    print(list(ansi_strip(str_val)))
