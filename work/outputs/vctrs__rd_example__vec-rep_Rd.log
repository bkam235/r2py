    def vec_rep(x, times):
        if isinstance(x, pd.DataFrame):
            # Repeat rows of data frame
            res = pd.concat([x] * times, ignore_index=True)
            res.index = np.arange(1, len(res) + 1)
            return res
        return np.tile(x, times)
    res1 = vec_rep(np.array([1, 2]), 3)
    print(f"[1] {' '.join(map(str, res1))}")
    
