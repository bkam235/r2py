  Python:
    def date_leap_year(x):
        """
        Returns TRUE if the date is in a leap year, FALSE otherwise.
        """
        def is_leap(dt):
            year = dt.year
            return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)
    
        if isinstance(x, (list, np.ndarray, pd.Series)):
            return np.array([is_leap(d) for d in x])
        else:
            return is_leap(x)
    
