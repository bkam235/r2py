    def one_string(lines):
        return "\n".join(lines)
    
    def str_wrap(*args, **kwargs):
        # xfun::str_wrap calls strwrap(..., simplify = FALSE) and joins
        res = strwrap(*args, **kwargs, simplify=False)
        return [one_string(item) for item in res]
    
