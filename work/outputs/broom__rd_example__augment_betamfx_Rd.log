        def glance(self):
            return pd.DataFrame({
                'pseudo.r.squared': [self.pseudo_r2],
                'df.null': [self.nobs - 1],
                'logLik': [self.loglik],
                'AIC': [self.aic],
                'BIC': [self.bic],
                'df.residual': [self.df_resid],
                'nobs': [self.nobs]
            })
    
