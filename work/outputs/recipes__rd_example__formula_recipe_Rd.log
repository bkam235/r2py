    def step_center(rec, *args, **kwargs):
        # In R, step_center adds a step to the recipe
        rec.steps.append('center')
        return rec
    
    def all_numeric():
        return 'all_numeric'
    iris_rec = step_center(iris_rec, all_numeric())
