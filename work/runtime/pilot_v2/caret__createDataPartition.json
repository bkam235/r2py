 "code": "import numpy as np\nimport pandas as pd\nimport random\nimport math\n\ndef r_createDataPartition(y, times=1, p=0.5, list=True, groups=None):\n    # Handle default for groups\n    if groups is None:\n        groups = min(5, len(y))\n    \n    # Convert y to numpy array for consistent handling\n    y_arr = np.asanyarray(y)\n    \n    # Handle Surv objects (which typically come in as DataFrames or similar in the harness)\n    if isinstance(y, pd.DataFrame) and 'time' in y.columns:\n        y_vals = y['time'].values\n    elif isinstance(y, np.ndarray) and len(y.shape) > 1:\n        # If it's a 2D array and we suspect it's a Surv-like structure\n        y_vals = y[:, 0] \n    else:\n        y_vals = y_arr\n\n    if len(y_vals) < 2:\n        raise ValueError(\"y must have at least 2 data points\")\n    \n    if groups < 2:\n        groups = 2\n\n    # Handle numeric y (binning into groups)\n    if np.issubdtype(y_vals.dtype, np.number):\n        # Quantile-based binning\n        # R's quantile(y, probs = seq(0, 1, length.out = groups))\n        probs = np.linspace(0, 1, groups)\n        q = np.quantile(y_vals, probs)\n        # Ensure unique breakpoints for cut\n        q = np.unique(q)\n        \n        # Implement R's cut(..., include.lowest = TRUE)\n        # We create bins and assign labels\n        bins = q\n        # Use digitize to mimic cut\n        # indices start at 1, 0 is below first bin, len(bins) is above last\n        indices = np.digitize(y_vals, bins, right=False)\n        # Adjust for include.lowest=True: items == bins[0] should be in bin 1\n        indices[y_vals == bins[0]] = 1\n        # Clip to range of available bins\n        indices = np.clip(indices, 1, len(bins) - 1)\n        y_categorized = indices\n    else:\n        # Handle categorical y\n        y_categorized = y_vals\n\n    # Store indices (1-based)\n    indices_arr = np.arange(1, len(y_vals) + 1)\n    \n    # Create a DataFrame to mimic the dlply operation\n    df = pd.DataFrame({'y': y_categorized, 'index': indices_arr})\n    \n    out_list = []\n    for j in range(times):\n        sample_indices = []\n        # Group by the processed y values\n        grouped = df.groupby('y')\n        for name, group in grouped:\n            n_row = len(group)\n            if n_row == 1:\n                # if (nrow(dat) == 1) { out <- dat$index }\n                sample_indices.append(group['index'].iloc[0])\n            else:\n                # num <- ceiling(nrow(dat) * p)\n                num = math.ceil(n_row * p)\n                # sample(dat$index, size = num)\n                # Use random.sample for sampling without replacement to match R's sample()\n                sampled = random.sample(group['index'].tolist(), num)\n                sample_indices.extend(sampled)\n        \n        # Sort the result as vectors in R's createDataPartition are sorted\n        sample_indices = sorted(sample_indices)\n        out_list.append(np.array(sample_indices))\n\n    if not list:\n        # Return as a matrix (numpy array)\n        # Ensure all lists are same length? R's unlist(out) then matrix() \n        # If lengths differ, this usually implies the user knows the structure\n        # However, createDataPartition typically produces consistent sizes per resample\n        res_matrix = np.column_stack(out_list)\n        return res_matrix\n    else:\n        # Return as a dictionary to mimic a named list\n        res_dict = {}\n        for i in range(times):\n            res_dict[f\"Resample{i+1}\"] = out_list[i]\n        return res_dict\n",
