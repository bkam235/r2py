 "code": "import numpy as np\nimport pandas as pd\nimport random\n\ndef r_createResample(y, times=10, list=True):\n    # Handling the 'Surv' object logic: if y is a DataFrame/structured array \n    # and we treat it as Surv, we take the \"time\" column.\n    # In the context of the provided R source, if y is not a Surv object, \n    # it just uses the length of y.\n    if isinstance(y, pd.DataFrame) and \"time\" in y.columns:\n        y_len = len(y)\n    elif hasattr(y, \"__len__\"):\n        y_len = len(y)\n    else:\n        y_len = 1 if y is not None else 0\n\n    # R's sample(index, size = length(index), replace = TRUE)\n    # Note: R indices are 1-based.\n    indices = np.arange(1, y_len + 1)\n    \n    resamples = []\n    for _ in range(times):\n        # Use random.choices or np.random.choice for replacement sampling\n        # The harness provides the random draws.\n        sample_indices = np.random.choice(indices, size=y_len, replace=True)\n        # R's sort() on the result\n        resamples.append(np.sort(sample_indices))\n    \n    # R's prettySeq generates names like \"Resample1\", \"Resample2\" or \"Resample01\"\n    def pretty_seq(n):\n        # Simple implementation of R's prettySeq for the purpose of 'Resample' labels\n        # R's prettySeq(1:times) typically yields \"Resample1\", \"Resample2\"... \n        # but for larger numbers it adds padding (e.g., Resample01).\n        # Based on the examples: if times=2 -> Resample1, if times=10 -> Resample01...Resample10\n        # Wait, the examples show: \n        # times=2 -> Resample1\n        # c(\"A\", \"A\", \"B\", \"B\") (default times=10) -> Resample01, Resample02...\n        # This behaves like sprintf(\"Resample%02d\", i) if times >= 10 else sprintf(\"Resample%d\", i)\n        # Actually, R's prettySeq is more complex, but for these cases:\n        fmt = \"Resample%02d\" if times >= 10 else \"Resample%d\"\n        return [fmt % i for i in range(1, n + 1)]\n\n    names = pretty_seq(times)\n    \n    if list:\n        # R returns a data.frame when list=TRUE (despite the param name)\n        # The output is a DataFrame where each column is a resample\n        df = pd.DataFrame({names[i]: resamples[i] for i in range(times)})\n        return df\n    else:\n        # R returns a matrix with column names\n        df = pd.DataFrame({names[i]: resamples[i] for i in range(times)})\n        return df\n",
