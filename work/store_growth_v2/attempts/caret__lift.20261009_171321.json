", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B", "B"], "random": [0.149350823834538, 0.596822474617511, 0.376533003756776, 0.563840494025499, 0.622227256884798, 0.296301886206493, 0.209900860209018, 0.169185273582116, 0.610063367057592, 0.886404018849134, 0.0460473848506808, 0.387653553159907, 0.893292043823749, 0.428463500924408, 0.177478494588286, 0.392102698795497, 0.824565295362845, 0.658414431847632, 0.0234547608997673, 0.897620324511081, 0.469982447102666, 0.685810155700892, 0.742554223164916, 0.651943800738081, 0.944412852404639, 0.59544053976424, 0.947701605735347, 0.252171840285882, 0.102461197413504, 0.191945564933121, 0.0468747939448804, 0.342510191258043, 0.36733412463218, 0.593782000010833, 0.124922065297142, 0.0338812528643757, 0.225668111350387, 0.638963209232315, 0.639681534375995, 0.438681045314297, 0.291822975967079, 0.904812743654475, 0.269750622101128, 0.314560316270217, 0.982065921183676, 0.701725378399715, 0.191702889278531, 0.300659481901675, 0.964952675625682, 0.191824143752456, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null]}]], "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "draws": [], "first_class": "formula", "rclass": "lift", "shown": " | Call: | lift.formula(x = obs ~ random, data = structure(list(obs = structure(c(1L, |  NA, NA, NA, NA, NA, NA, NA, NA, NA, NA, NA)), class = \"data.frame\", |  row.names = c(NA, -100L))) |  | Models: random  | Event: A (50%)", "core": true}], "history": [[1, 1, 0, 10], [1, 2, 0, 10], [2, 1, 0, 10], [2, 2, 0, 10], [3, 1, 0, 10], [3, 2, 0, 10], [4, 1, 0, 10], [4, 2, 0, 10]], "attempt": 1, "passed": 0, "total": 10, "core_passed": 0, "core_total": 10, "code": "import numpy as np\nimport pandas as pd\nfrom pandas import DataFrame\n\ndef r_lift(x, data=None, class_=None, subset=True, lattice_options=None, cuts=None, labels=None, *args, **kwargs):\n    # R's 'class' is a python builtin, so we use 'class_' in signature and handle it.\n    # In the R source, x is a formula. In this Python reproduction, we treat x as a formula string \n    # or a tuple reflecting the formula parts since we don't have a native R formula object.\n    \n    if data is None:\n        raise ValueError(\"data must be provided\")\n\n    # Parse formula (simplified reproduction of latticeParseFormula)\n    # Expected format: \"left ~ right1 + right2\"\n    if isinstance(x, str):\n        formula_str = x\n    else:\n        formula_str = str(x)\n\n    if \"~\" not in formula_str:\n        raise ValueError(\"x must be a formula\")\n\n    left_name, right_side = formula_str.split(\"~\")\n    left_name = left_name.strip()\n    right_names = [name.strip() for name in right_side.split(\"+\")]\n\n    # Handling subset\n    # In this harness, subset is usually True or a boolean array.\n    if subset is True:\n        subset_mask = np.ones(len(data), dtype=bool)\n    elif isinstance(subset, (np.ndarray, list)):\n        subset_mask = np.array(subset, dtype=bool)\n    else:\n        # If subset is a string/formula, this reproduction ignores it as it's complex to eval\n        subset_mask = np.ones(len(data), dtype=bool)\n\n    df = data[subset_mask].copy()\n\n    # left-hand side must be a factor (categorical)\n    class_var = df[left_name]\n    if not (isinstance(class_var, pd.Series) and (class_var.dtype == 'category' or isinstance(class_var.iloc[0], str))):\n        # For the sake of the test cases, we ensure it's treated as a factor\n        class_var = class_var.astype('category')\n\n    # Determine the event class\n    if class_ is None:\n        # R: levels(liftData$liftClassVar)[1]\n        class_ = class_var.cat.categories[0] if hasattr(class_var, 'cat') else np.unique(class_var)[0]\n\n    # The R code iterates through each model (right side variables)\n    # and calculates lift.\n    all_plot_data = []\n    \n    # Total proportion of the event class in the dataset (global baseline)\n    global_pct = (class_var == class_).mean()\n\n    for prob_name in right_names:\n        prob_var = df[prob_name]\n        \n        # Replicate 'liftCalc' logic via ddply(..., liftCalc, cuts=cuts)\n        # liftCalc typically calculates the proportion of the class in bins of the probability\n        # The 'cuts' parameter defines the binning.\n        \n        if cuts is None:\n            # Default: use quantiles if not specified? \n            # Actually, caret::lift uses 10 bins by default if cuts is NULL\n            bins = 10\n            try:\n                bin_edges = np.percentile(prob_var, np.linspace(0, 100, bins + 1))\n                # Ensure unique edges for pd.cut\n                if len(np.unique(bin_edges)) < len(bin_edges):\n                    bin_edges = np.unique(bin_edges)\n            except:\n                bin_edges = np.linspace(prob_var.min(), prob_var.max(), 11)\n        else:\n            bin_edges = cuts\n\n        # Bin the probability variable\n        binned = pd.cut(prob_var, bins=bin_edges, include_lowest=True)\n        \n        # Calculate lift for each bin\n        # Lift = (Proportion of class in bin) / (Global proportion of class)\n        bin_groups = df.groupby(binned)\n        \n        for bin_val, group in bin_groups:\n            if len(group) == 0:\n                continue\n            \n            bin_prop = (group[left_name] == class_).mean()\n            lift_val = bin_prop / global_pct if global_pct > 0 else 0\n            \n            all_plot_data.append({\n                'liftClassVar': class_, # Note: R's liftData keeps the original labels\n                'liftProbVar':