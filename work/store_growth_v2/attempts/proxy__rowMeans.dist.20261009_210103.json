\n        for i in range(j + 1, n):\n            val = x_arr[idx]\n            mat[i, j] = val\n            mat[j, i] = val\n            idx += 1\n            \n    if na_rm:\n        # np.nansum treats NaN as zero.\n        return np.nansum(mat, axis=1)\n    else:\n        # Standard sum: if any element in row is NaN, result is NaN.\n        # np.sum returns NaN if any value is NaN.\n        return np.sum(mat, axis=1)\n\ndef r_rowMeans_dist(x, na_rm=False, diag=True):\n    \"\"\"\n    Reproduce proxy::rowMeans.dist.\n    \"\"\"\n    if not isinstance(diag, (bool, np.bool_)):\n        # The R source says stop(\"'diag' not of type logical\")\n        raise TypeError(\"'diag' not of type logical\")\n\n    # In R, x is the distance vector. We ensure it's a numpy array for processing.\n    x_arr = np.atleast_1d(x)\n    \n    # Step 1: Calculate sums\n    s = r_rowSums_dist(x_arr, na_rm=na_rm)\n    \n    # Number of observations\n    n_elements = len(x_arr)\n    n = int((1 + np.sqrt(1 + 8 * n_elements)) // 2)\n    \n    if na_rm:\n        # R source logic:\n        # x[!(is.na(x) | is.nan(x))] <- 1\n        # s/(rowSums.dist(x, na.rm) + (diag == TRUE))\n        \n        # Create a copy of x and replace non-NA values with 1\n        x_mask = np.array(x_arr, copy=True, dtype=float)\n        mask = ~np.isnan(x_mask)\n        x_mask[mask] = 1.0\n        \n        # The denominator is the count of non-NA distances per row \n        # plus 1 if the diagonal (always 0, implicitly non-NA) is included.\n        counts = r_rowSums_dist(x_mask, na_rm=True)\n        denom = counts + (1.0 if diag else 0.0)\n        \n        return s / denom\n    else:\n        # R source: s / (length(s) - (diag == FALSE))\n        # length(s) is n. If diag is FALSE, denominator is n-1.\n        denom = n - (0 if diag else 1)\n        return s / denom\n", "failures": [{"call": "proxy::rowMeans.dist(dist(matrix(rnorm(100), 10)))  [first argument: an NA inserted]", "expected": [null, 4.8863528984676, 