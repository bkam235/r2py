fileext was a scalar, return a scalar (string)\n    # Otherwise return a list (character vector).\n    # Note: In R, if either is a vector, the result is a vector.\n    is_pattern_scalar = not isinstance(pattern, (list, np.ndarray))\n    is_ext_scalar = not isinstance(fileext, (list, np.ndarray))\n    \n    if is_pattern_scalar and is_ext_scalar and max_len == 1:\n        return results[0]\n    else:\n        return results\n", "failures": [{"call": "tempfile(\"Rex\")   [from the package's own examples]", "expected": "C:\\Users\\bened\\AppData\\Local\\Temp\\tmp7fivcf9a\\Rtmp4gVMXA\\Rex13487dc4b58", "got": "C:\\Users\\bened\\AppData\\Local\\Temp\\Rex37a86e4eb3d2", "core": true, "rclass": "character"}, {"call": "tempfile(c(\"ab\", \"a b c\"))   [from the package's own examples]", "expected": ["C:\\Users\\bened\\AppData\\Local\\Temp\\tmp7fivcf9a\\Rtmp4gVMXA\\ab1348798f2a42", "C:\\Users\\bened\\AppData\\Local\\Temp\\tmp7fivcf9a\\Rtmp4gVMXA\\a b c1348258e4d2c"], "got": ["C:\\Users\\bened\\AppData\\Local\\Temp\\ab167539ad3e8e", "C:\\Users\\bened\\AppData\\Local\\Temp\\a b cab730dee13"], "core": true, "rclass": "character"}, {"call": "tempfile(\"plot\", fileext = c(\".ps\", \".pdf\"))   [from the package's own examples]", "expected": ["C:\\Users\\bened\\AppData\\Local\\Temp\\tmp7fivcf9a\\Rtmp4gVMXA\\plot13484bd21fb.ps", "C:\\Users\\bened\\AppData\\Local\\Temp\\tmp7fivcf9a\\Rtmp4gVMXA\\plot134850db791c.pdf"], "got": ["C:\\Users\\bened\\AppData\\Local\\Temp\\plot8252ce8b7c42.ps", "C:\\Users\\bened\\AppData\\Local\\Temp\\plota43488a9317c.pdf"], "core": true, "rclass": "character"}, {"call": "tempfile(\"test\")", "expected": "C:\\Users\\bened\\AppData\\Local\\Temp\\tmpn9d_xt2b\\RtmpUvGWC1\\test5fa4467c19e8", "got": "C:\\Users\\bened\\AppData\\Local\\Temp\\test4955c4c2601a", "core": true, "rclass": "character"}, {"call": "tempfile(c(\"data1\", \"data2\", \"data3\"))", "expected": ["C:\\Users\\bened\\AppData\\Local\\Temp\\tmpn9d_xt2b\\RtmpUvGWC1\\data15fa4254b2c1f", "C:\\Users\\