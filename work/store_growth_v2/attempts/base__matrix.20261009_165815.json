ze + len(flat_data) - 1) // len(flat_data)\n        filling = np.tile(flat_data, reps)[:target_size]\n\n    # R fills the matrix by column by default (column-major)\n    if byrow:\n        # Fill row by row\n        res = filling.reshape((nrow, ncol))\n    else:\n        # Fill column by column\n        # Reshape as (ncol, nrow) then transpose to get (nrow, ncol)\n        res = filling.reshape((ncol, nrow)).T\n\n    # Note: dimnames is ignored as numpy arrays do not support named dimensions \n    # in the same way R matrices do. The return value should be the array.\n    \n    return res\n", "failures": [{"call": "matrix(list(a, b), nrow = 1)", "expected": [{"x": 0.5, "y": 0.5, "width": 1, "height": 1, "just": "centre", "hjust": {}, "vjust": {}, "name": "GRID.rect.1", "gp": {"fill": "red"}, "vp": {}}, {"x": 0.5, "y": 0.5, "r": 0.5, "name": "GRID.circle.2", "gp": [], "vp": {}}], "got": {"x": 0.5, "y": 0.5, "width": 1, "height": 1, "just": "centre", "hjust": {}, "vjust": {}, "name": "GRID.rect.1", "gp": {"fill": "red"}, "vp": {}}, "core": true, "rclass": "matrix"}, {"call": "matrix(list(a, b), ncol = 1)", "expected": [{"x": 0.5, "y": 0.5, "width": 1, "height": 1, "just": "centre", "hjust": {}, "vjust": {}, "name": "GRID.rect.1", "gp": {"fill": "red"}, "vp": {}}, {"x": 0.5, "y": 0.5, "r": 0.5, "name": "GRID.circle.2", "gp": [], "vp": {}}], "got": {"x": 0.5, "y": 0.5, "width": 1, "height": 1, "just": "centre", "hjust": {}, "vjust": {}, "name": "GRID.rect.1", "gp": {"fill": "red"}, "vp": {}}, "core": true, "rclass": "matrix"}, {"call": "matrix(list(a, b, c, nullGrob()), nrow = 2)", "expected": [{"x": 0.5, "y": 0.5, "width": 1, "height": 1, "just": "centre", "hjust": {}, "vjust": {}, "name": "GRID.rect.1", "gp": {"fill": "red"}, "vp": {}}, {"x": 0.5, "y": 0.5, "r": 0.5, "name": "GRID.circle.2", "gp": [], "vp": {}}, {"x": [0, 1], "y": [0, 1], "arrow": {}, "name": "GRID.lines.3", "gp": [], "vp": {}}, {"x": 0.5, "y": 0.5, "name": "GRID.null.5", "gp": {}, "vp": {}}], "got": [