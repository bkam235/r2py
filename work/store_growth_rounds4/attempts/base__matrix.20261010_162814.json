ol, nrow)).T is equivalent to filling column-major\n            res_mat = fill_data.reshape((ncol, nrow)).T\n\n    # 4. Handle dimnames\n    # The harness expects the \"values\" part of the return.\n    # Based on the failing cases, R returns values as a nested list/array.\n    # If dimnames are provided, R returns a matrix. In Python, a numpy array \n    # with values corresponds to the 'values' part of the R matrix.\n    # The test failures show the harness expects a numpy-like array/list of lists, \n    # not a pandas DataFrame dictionary.\n    \n    # If the input was strings/objects, ensure numpy array is dtype object\n    # to handle mixed types (like ints and \"NA\" strings) as R does.\n    if data_flat.dtype == object:\n        res_mat = res_mat.astype(object)\n\n    # Return the result as a numpy array (which the harness serializes as nested lists)\n    return res_mat\n", "failures": [{"call": "matrix(runif(10 * 2), ncol = 2)", "expected": [[0.0807584524154663, 0.488225398119539], [0.919869226170704, 0.404940620530397], [0.11555497162044, 0.203710062429309], [0.631088109686971, 0.057986824773252], [0.97680274490267, 0.84888700558804], [0.68022915488109, 0.711047892458737], [0.703662489773706, 0.38852752931416], [0.322870263829827, 0.177754590287805], [0.972119821002707, 0.996103060664609], [0.537623757962137, 0.395835500443354]], "got": [0.0807584524154663, 0.919869226170704], "core": true, "rclass": "matrix"}, {"call": "matrix(c(1, 2, 3, 11, 12, 13), nrow = 2, ncol = 3, byrow = TRUE,      dimnames = list(c(\"row1\", \"row2\"), c(\"C.1\", \"C.2\", \"C.3\")))  [first argument: an NA inserted]   [from the package's own examples]", "expected": [[1, "NA", 3], [11, 12, 13]], "got": [["1", "NA", "3"], ["11", "12", "13"]], "core": true, "rclass": "matrix"}, {"call": "matrix(rep(1:5, 2), nrow = 2)", "expected": [[1, 3, 5, 2, 4], [2, 4, 1, 3, 5]], "got": [[1.0], [2.0]], "core": false, "rclass": "matrix"}, {"call": "matrix(rep(1:5, 2), nrow = 2)  [first argument: an 