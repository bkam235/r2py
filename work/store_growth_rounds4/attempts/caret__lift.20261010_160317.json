 the provided example calls, x is always a formula.\n        return None\n\n    parts = formula_str.split('~')\n    lhs_name = parts[0].strip()\n    rhs_expr = parts[1].strip()\n\n    if data is None:\n        return None\n\n    df = data.copy()\n    \n    # Subset handling\n    if subset is not True:\n        if isinstance(subset, str):\n            df = df.query(subset)\n        elif isinstance(subset, (np.ndarray, list)):\n            df = df.iloc[np.array(subset).astype(bool)]\n        elif callable(subset):\n            df = df[subset(df)]\n\n    # Extract LHS (Target)\n    if lhs_name not in df.columns:\n        return None\n    y = df[lhs_name]\n    \n    # Extract RHS (Models/Probabilities)\n    # R's strsplit(form$right.name, \" + \", fixed = TRUE)\n    prob_names = [p.strip() for p in rhs_expr.split('+')]\n    \n    # Create lift_data (long format)\n    lift_list = []\n    for prob_name in prob_names:\n        if prob_name not in df.columns:\n            continue\n        temp = pd.DataFrame({\n            'liftClassVar': y.values,\n            'liftProbVar': df[prob_name].values,\n            'liftModelVar': prob_name\n        })\n        lift_list.append(temp)\n    \n    if not lift_list:\n        return None\n        \n    lift_data = pd.concat(lift_list, axis=0).reset_index(drop=True)\n    \n    # Handle class parameter\n    if class_ is None:\n        if hasattr(y, 'cat'):\n            class_ = y.cat.categories[0]\n        else:\n            unique_vals = y.unique()\n            if len(unique_vals) > 0:\n                class_ = unique_vals[0]\n            else:\n                class_ = None\n\n    # R's liftCalc logic approximation\n    def lift_calc(group):\n        probs = group['liftProbVar']\n        targets = group['liftClassVar']\n        \n        # overall_rate is calculated on the whole liftData subset for that model\n        # in R: mean(liftData$liftClassVar == class)\n        overall_rate = (targets == class_).mean()\n        \n        i