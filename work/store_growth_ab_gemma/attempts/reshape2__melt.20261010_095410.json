irst_class": "list", "rclass": "data.frame", "shown": "   value L1 | 1      1  1 | 2      2  1 | 3      3  1 | 4      4  1 | 5      5  1 | 6      1  2 | 7      1  2 | 8      1  2 | 9      1  2 | 10     1  2", "core": false}], "history": [[1, 1, 10, 16], [1, 2, 10, 16], [2, 1, 10, 16], [2, 2, 10, 16], [3, 1, 10, 16], [3, 2, 10, 16], [4, 1, 10, 16], [4, 2, 10, 16], [5, 1, 10, 16], [5, 2, 10, 16], [6, 1, 10, 16], [6, 2, 10, 16], [7, 1, 10, 16], [7, 2, 10, 16], [8, 1, 10, 16], [8, 2, 10, 16]], "attempt": 2, "passed": 12, "total": 26, "core_passed": 10, "core_total": 16, "code": "import numpy as np\nimport pandas as pd\n\ndef r_melt(data, *args, **kwargs):\n    \"\"\"\n    Python reproduction of reshape2::melt.\n    The function handles recursive melting of lists, matrices, and vectors.\n    \"\"\"\n    level = kwargs.get('level', 1)\n    \n    # 1. Base Case: Atomic Vector (or simple list of numbers)\n    # In R, a vector is melted into a data.frame with a single column 'value'\n    if isinstance(data, (np.ndarray, list)):\n        # Check if it is a flat list of scalars\n        if not any(isinstance(i, (list, np.ndarray, pd.DataFrame, dict)) for i in data):\n            return pd.DataFrame({'value': data})\n    \n    # 2. Base Case: Matrix ( numpy array of rank 2)\n    # In R, melt(matrix) creates Var1 (row), Var2 (col) and value\n    if isinstance(data, np.ndarray) and data.ndim == 2:\n        rows, cols = data.shape\n        var1 = np.repeat(np.arange(1, rows + 1), cols)\n        var2 = np.tile(np.arange(1, cols + 1), rows)\n        value = data.flatten()\n        return pd.DataFrame({'Var1': var1, 'Var2': var2, 'value': value})\n\n    # 3. Handle the Recursive Step for Lists / Dicts (the provided R source)\n    # Determine the data structure to iterate over\n    if isinstance(data, dict):\n        # Use dict keys as names\n        names_list = list(data.keys())\n        values_list = list(data.values())\n    elif isinstance(data, list):\n        # Use 1-based indices as names (matching R's seq_along)\n        names_list = [i + 1 for i in range(len(data))]\n        values_list = data\n    elif isinstance(data, pd.DataFrame):\n        names_list = data.columns.tolist()\n        values_list = [data[col].values for col in names_list]\n    else:\n        # Single scalar case\n        return pd.DataFrame({'value': [data]})\n\n    parts = []\n    for val in values_list:\n        # Recursive call: melt(val, level = level + 1, ...)\n        new_kwargs = kwargs.copy()\n        new_kwargs['level'] = level + 1\n        res = r_melt(val, *args, **new_kwargs)\n        parts.append(res)\n\n    # rbind.fill(parts) equivalent: outer join on columns\n    result = pd.concat(parts, axis=0, ignore_index=True, sort=False)\n    \n    # Label variable name logic: attr(data, \"varname\") %||% paste(\"L\", level, sep = \"\")\n    label_var = kwargs.get('varname', f\"L{level}\")\n    \n    # Calculate labels\n    lengths = [len(p) for p in parts]\n    labels = []\n    for name, length in zip(names_list, lengths):\n        labels.extend([name] * length)\n    \n    result[label_var] = labels\n    \n    # Order columns to put 'value' first if it exists, then Var's, then L's\n    cols = result.columns.tolist()\n    # To mimic R's behavior, if 'value' is present, it usually leads.\n    if 'value' in cols:\n        cols.remove('value')\n        # Sort Var columns numerically: Var1, Var2...\n        var_cols = sorted([c for c in cols if c.startswith('Var')], \n                          key=lambda x: int(x[3:]) if x[3:].isdigit() else x)\n        other_cols = [c for c in cols if not c.startswith('Var')]\n        final_cols = ['value'] + var_cols + other_cols\n        return result[final_cols]\n    \n    return result\n", "failures": [{"call": "melt(a)", "expected": {"value": [1, 2, 3, 4, null], "L1": ["a", "b", "c", "d", null]}, "got": {"value": [1, 2, 3, 4, null], "L1": ["a", "b", "c", "d", "5"]}, "core": true, "rclass": "data.frame"}, {"call": "melt(a)", "ex