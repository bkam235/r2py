       # R's factor levels are unique values sorted alphabetically usually\n            class_ = sorted(y.unique())[0]\n\n    # Calculate the baseline probability (Event Rate)\n    # pct = mean(liftData$liftClassVar == class) * 100\n    event_rate = np.mean(y == class_)\n\n    # We need to calculate lift for each model variable (rhs)\n    # liftCalc in R usually involves binning the predicted probabilities (cuts)\n    # and calculating the proportion of events in each bin relative to the baseline.\n    \n    all_plot_data = []\n\n    for model_var in prob_vars:\n        probs = df[model_var].values\n        # Create the liftData structure for this specific model\n        temp_df = pd.DataFrame({\n            'liftClassVar': y,\n            'liftProbVar': probs,\n            'liftModelVar': model_var\n        })\n        \n        # Determine cuts for binning\n        if cuts is None:\n            # Default: Use deciles (10 bins) if not specified\n            # R's caret::lift uses the 'cuts' parameter to decide how to slice the data\n            # If cuts is NULL, it typically uses 10 quantiles.\n            bins = np.linspace(0, 1, 11) # This is a simplification, but standard for lift\n            # Actually, the R code calls liftCalc. liftCalc typically does:\n            # bins = cut(probs, breaks = cuts)\n            # Since we don't have the internal liftCalc, we implement the standard lift logic:\n            \n            # In R, if cuts is NULL, it's usually handled by the plotting function\n            # but here we need to generate the data. \n            # Let's use quantiles to create 10 bins.\n            try:\n                bins = np.quantile(probs, np.linspace(0, 1, 11))\n                # Remove duplicates from bins to avoid errors in pd.cut\n                bins = np.unique(bins)\n            except:\n                bins = np.linspace(probs.min(), probs.max(), 11)\n        else:\n            bins = cuts\n\n        temp_df['bin'] = pd.cut(temp_df['liftProbVar'], bins=bins, include_lowest=True)\n        \n        # Group by bin and calculate lift\n        # lift = (prop of class in bin) / (prop of class overall)\n        bin_groups = temp_df.groupby('bin', observed=True)\n        \n        for bin_val, group in bin_groups:\n            prop_in_bin = np.mean(group['liftClassVar'] == class_)\n            lift_val = prop_in_bin / event_rate if event_rate > 0 else 0\n            \n            all_plot_data.append({\n                'liftModelVar': model_var,\n                'bin': bin_val,\n                'lift': lift_val,\n                'prop': prop_in_bin\n            })\n\n    plot_data = pd.DataFrame(all_plot_data)\n\n    # Handle labels\n    if labels is not None:\n        # labels is a dict or Series mapping original name to label\n        mapping = labels if isinstance(labels, dict) else dict(zip(labels.index, labels.values))\n        plot_data['liftModelVar'] = plot_data['liftModelVar'].map(mapping).fillna(plot_data['liftModelVar'])\n        # Ensure factor levels\n        plot_data['liftModelVar'] = pd.Categorical(plot_data['liftModelVar'], categories=list(labels.keys()) if isinstance(labels, dict) else labels)\n\n    # Result structure\n    return {\n        'data': plot_data,\n        'class': class_,\n        'probNames': prob_vars,\n        'pct': event_rate * 100,\n        'call': f\"lift(x = {formula_str}, data = data)\"\n    }\n", "failures": [{"call": "lift(obs ~ random, data = simulated)", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: not enough values to unpack (expected 2, got 1)", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ random, data = simulated)   [from the package's own examples]", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: not enough values to unpack (expected 2, got 1)", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ random, data = data.frame(obs = factor(