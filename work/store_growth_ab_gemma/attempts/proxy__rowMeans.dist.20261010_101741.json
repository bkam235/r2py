, "core_passed": 14, "core_total": 20, "code": "import numpy as np\nimport pandas as pd\n\ndef r_rowSums_dist(x, na_rm=False):\n    \"\"\"\n    Reproduces proxy::rowSums.dist.\n    In R's dist objects, the distance vector is stored as:\n    d[1,2], d[1,3], ..., d[1,n], d[2,3], ..., d[n-1,n].\n    \"\"\"\n    x = np.asarray(x)\n    n = int(np.ceil((1 + np.sqrt(1 + 8 * len(x))) / 2))\n    \n    dist_mat = np.zeros((n, n))\n    k = 0\n    # R's dist objects are stored row-wise for the lower triangle:\n    # (1,2), (1,3)...(1,n), (2,3)...(2,n), (3,4)...\n    # Wait, the standard R dist storage is:\n    # d[1,2], d[1,3], ..., d[1,n], d[2,3], ..., d[2,n] ...\n    # This corresponds to the upper triangle.\n    for i in range(n):\n        for j in range(i + 1, n):\n            dist_mat[i, j] = x[k]\n            dist_mat[j, i] = x[k]\n            k += 1\n            \n    if na_rm:\n        return np.nansum(dist_mat, axis=1)\n    else:\n        # If any element in the row is NaN, the sum is NaN\n        res = np.sum(dist_mat, axis=1)\n        mask = np.isnan(dist_mat).any(axis=1)\n        res[mask] = np.nan\n        return res\n\ndef r_rowMeans_dist(x, na_rm=False, diag=True):\n    \"\"\"\n    Reproduces proxy::rowMeans.dist\n    \"\"\"\n    if not isinstance(diag, (bool, np.bool_)):\n        raise TypeError(\"'diag' not of type logical\")\n\n    s = r_rowSums_dist(x, na_rm=na_rm)\n    n = len(s)\n    \n    if na_rm:\n        # Reconstruct the distance matrix to count non-NA entries per row\n        x_arr = np.asarray(x)\n        n_obs = int(np.ceil((1 + np.sqrt(1 + 8 * len(x_arr))) / 2))\n        \n        # We need the count of non-NA values in each row of the full symmetric matrix\n        # The distance vector x represents the upper triangle.\n        # The diagonal is always 0 (not NA).\n        \n        # Calculate counts for the off-diagonals\n        counts = np.zeros(n_obs)\n        k = 0\n        for i in range(n_obs):\n            for j in range(i + 1, n_obs):\n                if not np.isnan(x_arr[k]):\n                    counts[i] += 1\n                    counts[j] += 1\n                k += 1\n        \n        # Add diagonal if diag is TRUE\n        divisor = counts + (1 if diag else 0)\n        return s / divisor\n    else:\n        # R: s/(length(s) - (diag == FALSE))\n        # diag == FALSE is 1 if False, 0 if True\n        divisor = n - (1 if not diag else 0)\n        return s / divisor\n", "failures": [{"call": "proxy::rowMeans.dist(dist(matrix(runif(10), 2, 5)))", "expected": [0.478352115249498, 0.478352115249498], "error": "TypeError: len() of unsized object", "core": true, "rclass": "numeric"}, {"call": "proxy::rowMeans.dist(dist(matrix(runif(10), 2, 5)), diag = FALSE)", "expected": [0.603917936307943, 0.603917936307943], "error": "TypeError: len() of unsized object", "core": true, "rclass": "numeric"}, {"call": "proxy::rowMeans.dist(dist(matrix(c(1, 2, NA, 4, 5, 6), 2, 3)), na.rm = TRUE)", "expected": [0.866025403784439, 0.866025403784439], "error": "TypeError: len() of unsized object", "core": true, "rclass": "numeric"}, {"call": "proxy::rowMeans.dist(dist(matrix(runif(4), 2, 2)))", "expected": [0.144794214598889, 0.144794214598889], "error": "TypeError: len() of unsized object", "core": true, "rclass": "numeric"}, {"call": "proxy::rowMeans.dist(dist(matrix(c(1, NA, 3, NA), 2, 2)), na.rm = TRUE)", "expected": [0, 0], "error": "TypeError: len() of unsized object", "core": true, "rclass": "numeric"}, {"call": "proxy::rowMeans.dist(dist(matrix(runif(25), 5, 5)), diag = FALSE)  [first argument: an NA inserted]", "expected": [null, 0.715247920999524, null, 0.54031451287743, 0.582578067015768], "got": [null, 0.6207535321329992, null, 0.7934129490321333, 0.869897984787978], "core": true, "rclass": "numeric"}], "n_failures": 6, "examples": "# calls recorded from these examples and this script:\nrowMeans.dist(d)\nrowMeans.dist(d, diag = FALSE)\nrowMeans.dist(d, na.rm = TRUE)"}