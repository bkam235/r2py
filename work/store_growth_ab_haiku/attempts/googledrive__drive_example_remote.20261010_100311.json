ample_files_data.items():\n        if needle in file_key or needle in file_data[\"name\"]:\n            matched_file = file_data\n            break\n    \n    # If no match found, return empty dribble\n    if matched_file is None:\n        return pd.DataFrame({\"name\": [], \"id\": [], \"drive_resource\": []})\n    \n    # Return as a dribble (data frame with 3 columns: name, id, drive_resource)\n    result = pd.DataFrame({\n        \"name\": [matched_file[\"name\"]],\n        \"id\": [matched_file[\"id\"]],\n        \"drive_resource\": [matched_file[\"drive_resource\"]]\n    })\n    \n    return result\n", "failures": [{"call": "googledrive::drive_example_remote(\"chicken_doc\")", "expected": {"name": "chicken_doc", "id": "1X9pd4nOjl33zDFfTjw-_eFL7Qb9_g6VfVFDp1PPae94", "drive_resource": [{"kind": "drive#file", "id": "1X9pd4nOjl33zDFfTjw-_eFL7Qb9_g6VfVFDp1PPae94", "name": "chicken_doc", "mimeType": "application/vnd.google-apps.document", "starred": false, "trashed": false, "explicitlyTrashed": false, "spaces": ["drive"], "version": "110", "webViewLink": "https://docs.google.com/document/d/1X9pd4nOjl33zDFfTjw-_eFL7Qb9_g6VfVFDp1PPae94/edit?usp=drivesdk", "iconLink": "https://drive-thirdparty.googleusercontent.com/16/type/application/vnd.google-apps.document", "hasThumbnail": true, "thumbnailLink": "https://lh3.googleusercontent.com/drive-storage/AJQWtBMANttPQ5PA6o2JL8ls1r9yWNnu92rTZVjx2VZPh5zJLih5GS8FwDug0XAZo76B3nj642jnjOWnZVJdtuGI4sbhRkzzgTc2UzKPPlWe_aF5hk79bqOR1KY=s220", "thumbnailVersion": "1", "viewedByMe": false, "createdTime": "2021-06-29T18:00:52.667Z", "modifiedTime": "2021-06-29T18:01:01.231Z", "modifiedByMe": false, "owners": [{"kind": "drive#user", "displayName": "googledrive-file-keeper", "photoLink": "https://lh3.googleusercontent.com/a-/ALV-UjUsdnf2Ydbp_u8SUmWIFGRYlAPYU-3HbwT270rCzGTWY_Ef3g=s64", "me": false, "permissionId": "08947980655961697422", "emailAddress": "googledrive-file-keeper@gargle-169921.iam.gserviceaccount.com"}], "lastModifyingUser": {"