 ~ x'\")\n        left_var = parts[0].strip()\n        right_part = parts[1].strip()\n    else:\n        # x is passed as a formula object, extract its structure\n        # We'll work with what we can infer from data\n        raise ValueError(\"Formula must be a string\")\n    \n    # Handle subset\n    if isinstance(subset, bool):\n        if subset:\n            subset_mask = np.ones(len(data), dtype=bool)\n        else:\n            subset_mask = np.zeros(len(data), dtype=bool)\n    else:\n        subset_mask = np.array(subset, dtype=bool)\n    \n    data_subset = data[subset_mask].copy()\n    \n    # Extract left and right variables\n    if left_var not in data_subset.columns:\n        raise ValueError(f\"Variable {left_var} not found in data\")\n    \n    liftClassVar = data_subset[left_var].values\n    \n    # Parse right side - could have multiple variables or conditioning\n    right_vars = [v.strip() for v in right_part.split('+')]\n    \n    probNames = right_vars\n    \n    # Build lift data frame\n    liftData = pd.DataFrame({\n        'liftClassVar': liftClassVar,\n        'liftProbVar': data_subset[right_vars[0]].values if len(right_vars) > 0 else np.nan,\n        'liftModelVar': right_vars[0] if len(right_vars) == 1 else right_vars[0]\n    })\n    \n    # Add additional variables if multiple\n    for i, var in enumerate(right_vars[1:], 1):\n        liftData[f'split_{i}'] = data_subset[var].values\n    \n    # Determine class (default to first level of factor)\n    if not isinstance(liftClassVar[0], (int, np.integer)):\n        # It's likely a factor/categorical\n        unique_classes = pd.unique(liftClassVar)\n        if class_var is None:\n            class_var = unique_classes[0]\n    else:\n        if class_var is None:\n            class_var = liftClassVar[0]\n    \n    # Calculate lift - group by model and compute lift metrics\n    split_cols = [col for col in liftData.columns if col.startswith('split_')]\n    group_cols = [c for c in liftData.columns if c not in ['liftClassVar', 'liftProbVar']]\n    \n    if len(group_cols) == 0:\n        group_cols = ['liftModelVar']\n    \n    # Create bins if cuts specified\n    if cuts is not None:\n        liftData['cut'] = pd.cut(liftData['liftProbVar'], bins=cuts, labels=False, duplicates='drop')\n        group_cols.insert(0, 'cut')\n    \n    # Group and calculate\n    plotData_list = []\n    for group_vals, group_df in liftData.groupby(group_cols, observed=True):\n        if not isinstance(group_vals, tuple):\n            group_vals = (group_vals,)\n        \n        n_samples = len(group_df)\n        n_events = np.sum(group_df['liftClassVar'] == class_var)\n        \n        # Calculate lift metrics\n        baseline_rate = np.mean(liftData['liftClassVar'] == class_var)\n        if baseline_rate > 0:\n            event_rate = n_events / n_samples if n_samples > 0 else 0\n            lift_val = event_rate / baseline_rate\n        else:\n            lift_val = 1.0\n        \n        row_dict = {\n            'liftModelVar': group_vals[0] if len(group_vals) == 1 else group_vals[-1],\n            'Bin': group_vals[0] if len(group_vals) > 1 and group_cols[0] == 'cut' else 1,\n            'n': n_samples,\n            'events': n_events,\n            'lift': lift_val,\n            'pct_events': (n_events / np.sum(liftData['liftClassVar'] == class_var) * 100) if np.sum(liftData['liftClassVar'] == class_var) > 0 else 0,\n            'pct_samples': (n_samples / len(liftData) * 100)\n        }\n        plotData_list.append(row_dict)\n    \n    plotData = pd.DataFrame(plotData_list)\n    \n    # Calculate percentage\n    pct = np.mean(liftData['liftClassVar'] == class_var) * 100\n    \n    # Return object\n    out = {\n        'data': plotData,\n        'class': class_var,\n        'probNames': probNames,\n        'pct': pct,\n        'call': f'lift({left_var} ~ {right_part}, data=...)'\n    }\n    \n    return out\n", "failures": [{"call": "lift(obs ~ random, data = simulated)", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ random, data = simulated)   [from the package's own examples]", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ random, data = data.frame(obs = factor(rep(letters[1:2], each = 50)), random = runif(100)))", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ x, data = data.frame(obs = factor(c(\"a\", \"b\")), x = c(0.5, 0.3)))", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ random + perfect, data = data.frame(obs = factor(rep(letters[1:2], 75)), perfect = sort(runif(150), decreasing = TRUE), random = runif(150)), class = \"a\")", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ v1 + v2 + v3, data = data.frame(obs = factor(rep(c(\"yes\", \"no\"), 60)), v1 = runif(120), v2 = runif(120), v3 = runif(120)))", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 50}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}, {"call": "lift(obs ~ perfect, data = data.frame(obs = factor(c(rep(\"pos\", 80), rep(\"neg\", 20))), perfect = c(sort(runif(80), decreasing = TRUE), runif(20))))", "expected": {"__r2py_fp__": true, "class": ["lift"], "numbers": {"pct": 20}}, "error": "ValueError: Formula must be of the form 'y ~ x'", "core": true, "rclass": "lift"}], "n_failures": 7, "examples": "### Name: lift\n### Title: Lift Plot\n### Aliases: lift lift.formula lift.default xyplot.lift print.lift\n###   ggplot.lift\n### Keywords: hplot\n\n### ** Examples\n\n\nset.seed(1)\nsimulated <- data.frame(obs = factor(rep(letters[1:2], each = 100)),\n                        perfect = sort(runif(200), decreasing = TRUE),\n                        random = runif(200))\n\nlift1 <- lift(obs ~ random, data = simulated)\nlift1\nxyplot(lift1)\n\nlift2 <- lift(obs ~ random + perfect, data = simulated)\nlift2\nxyplot(lift2, auto.key = list(columns = 2))\n\nxyplot(lift2, auto.key = list(columns = 2), value = c(10, 30))\n\nxyplot(lift2, plot = \"lift\", auto.key = list(columns = 2))\n\n# calls recorded from these examples and this script:\nlift(obs ~ random, data = simulated)"}