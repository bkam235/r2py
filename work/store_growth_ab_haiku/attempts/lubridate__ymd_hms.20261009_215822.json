 numpy as np\nimport pandas as pd\nfrom datetime import datetime\nimport re\nimport pytz\n\ndef r_ymd_hms(*args, quiet=False, tz=\"UTC\", locale=None, truncated=0):\n    \"\"\"\n    Parse dates in year-month-day hour-minute-second format.\n    \n    Mimics lubridate::ymd_hms behavior.\n    \"\"\"\n    if len(args) == 0:\n        return np.array([], dtype='object')\n    \n    # Flatten args - could be multiple strings or a list\n    inputs = []\n    for arg in args:\n        if isinstance(arg, (list, np.ndarray)):\n            inputs.extend(arg)\n        elif isinstance(arg, str):\n            inputs.append(arg)\n        else:\n            inputs.append(str(arg))\n    \n    if len(inputs) == 0:\n        return np.array([], dtype='object')\n    \n    # Parse each input\n    results = []\n    for x in inputs:\n        parsed = _parse_ymd_hms_single(x)\n        if parsed is not None:\n            # Create timezone-naive datetime first, then localize\n            if tz and tz != \"UTC\":\n                # Parse as naive datetime in the target timezone\n                tz_obj = pytz.timezone(tz)\n                parsed_localized = tz_obj.localize(parsed)\n                results.append(pd.Timestamp(parsed_localized))\n            else:\n                # Parse as UTC\n                parsed_utc = parsed.replace(tzinfo=pytz.UTC)\n                results.append(pd.Timestamp(parsed_utc))\n        else:\n            results.append(pd.NaT)\n    \n    # Return as numpy array of Timestamps\n    return np.array(results, dtype='object')\n\n\ndef _parse_ymd_hms_single(x):\n    \"\"\"\n    Parse a single datetime string in various ymd_hms formats.\n    Handles the flexible format parsing that lubridate does.\n    \"\"\"\n    if not isinstance(x, str) or x.strip() == \"\":\n        return None\n    \n    x = x.strip()\n    \n    # Extract all digit sequences\n    digit_pattern = r'(\\d+)'\n    digits = re.findall(digit_pattern, x)\n    \n    if len(digits) < 3:  # Need at least year, month, day\n        return None\n    \n    # Try to identify what each digit sequence represents\n    year = None\n    month = None\n    day = None\n    hour = 0\n    minute = 0\n    second = 0\n    \n    try:\n        if len(digits) >= 6:\n            # Full format with time\n            year = int(digits[0])\n            month = int(digits[1])\n            day = int(digits[2])\n            hour = int(digits[3])\n            minute = int(digits[4])\n            second = int(digits[5])\n        elif len(digits) == 5:\n            # YYYY MM DD HH MM\n            year = int(digits[0])\n            month = int(digits[1])\n            day = int(digits[2])\n            hour = int(digits[3])\n            minute = int(digits[4])\n        elif len(digits) == 4:\n            # YYYY MM DD HH or other combinations\n            year = int(digits[0])\n            month = int(digits[1])\n            day = int(digits[2])\n            hour = int(digits[3])\n        elif len(digits) >= 3:\n            # At least YYYY MM DD\n            year = int(digits[0])\n            month = int(digits[1])\n            day = int(digits[2])\n        \n        if year is None or month is None or day is None:\n            return None\n        \n        # Handle 2-digit or 1-digit years\n        if year < 100:\n            if year < 70:\n                year += 2000\n            else:\n                year += 1900\n        \n        # Validate ranges\n        if month < 1 or month > 12:\n            return None\n        if day < 1 or day > 31:\n            return None\n        if hour < 0 or hour > 23:\n            return None\n        if minute < 0 or minute > 59:\n            return None\n        if second < 0 or second > 59:\n            return None\n        \n        result = datetime(year, month, day, hour, minute, second)\n        return result\n    except (ValueError, IndexError):\n        return None\n", "failures": [{"call": "ymd_hms(x)   [from the package's own examples]", "expected": ["2