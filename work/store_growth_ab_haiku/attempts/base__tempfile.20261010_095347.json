tterns = np.array([pattern])\n    else:\n        patterns = np.asarray(pattern, dtype=object)\n    \n    if isinstance(fileext, str):\n        exts = np.array([fileext])\n    else:\n        exts = np.asarray(fileext, dtype=object)\n    \n    # Determine output length (R recycles shorter arguments)\n    n = max(len(patterns), len(exts))\n    \n    # Recycle patterns and extensions to length n\n    patterns = np.tile(patterns, (n + len(patterns) - 1) // len(patterns))[:n]\n    exts = np.tile(exts, (n + len(exts) - 1) // len(exts))[:n]\n    \n    # Generate temp file names\n    result = []\n    for pat, ext in zip(patterns, exts):\n        # Use tempfile.NamedTemporaryFile to generate a unique name\n        # then close it (we just want the name, not an open file)\n        fd, path = _tempfile.mkstemp(prefix=pat, suffix=ext, dir=tmpdir)\n        os.close(fd)\n        # Remove the file since R's tempfile just generates names\n        try:\n            os.remove(path)\n        except OSError:\n            pass\n        result.append(path)\n    \n    # Return as numpy array if multiple values, single string if one\n    if len(result) == 1:\n        return np.array(result)\n    else:\n        return np.array(result)\n", "failures": [{"call": "tempfile(\"Rex\")   [from the package's own examples]", "expected": "C:\\Users\\bened\\AppData\\Local\\Temp\\tmpwewxsdon\\RtmpAv7p5s\\Rex13b450a61e43", "got": "C:\\Users\\bened\\AppData\\Local\\Temp\\Rexv_mqxhfb", "core": true, "rclass": "character"}, {"call": "tempfile(c(\"ab\", \"a b c\"))   [from the package's own examples]", "expected": ["C:\\Users\\bened\\AppData\\Local\\Temp\\tmpwewxsdon\\RtmpAv7p5s\\ab13b4274b1203", "C:\\Users\\bened\\AppData\\Local\\Temp\\tmpwewxsdon\\RtmpAv7p5s\\a b c13b46e1d3bfd"], "got": ["C:\\Users\\bened\\AppData\\Local\\Temp\\abbo2ahd1_", "C:\\Users\\bened\\AppData\\Local\\Temp\\a b cjz57365k"], "core": true, "rclass": "character"}, {"call": "tempfile(\"plot\", fileext = c(\".ps\", \".pdf\"))   [from the