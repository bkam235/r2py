mple2": [1, 2, 4, 5]}, "got": [[1, 2, 2, 4], [2, 3, 3, 5]], "core": false, "rclass": "list"}, {"call": "caret::createDataPartition(y = c(TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE), times = 1, p = 0.5, list = FALSE, groups = 2)", "expected": [[3], [4], [5], [6]], "got": [[2.0], [3.0], [4.0], [6.0]], "core": false, "rclass": "matrix"}, {"call": "caret::createDataPartition(y = c(TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE), times = 1, p = 0.5, list = FALSE, groups = 2)  [first argument: reversed]", "expected": [[3], [4], [6], [7]], "got": [[2.0], [3.0], [4.0], [7.0]], "core": false, "rclass": "matrix"}], "n_failures": 18, "examples": "### Name: createDataPartition\n### Title: Data Splitting functions\n### Aliases: createDataPartition createResample createFolds\n###   createMultiFolds createTimeSlices groupKFold\n### Keywords: utilities\n\n### ** Examples\n\n\ndata(oil)\ncreateDataPartition(oilType, 2)\n\nx <- rgamma(50, 3, .5)\ninA <- createDataPartition(x, list = FALSE)\n\nplot(density(x[inA]))\nrug(x[inA])\n\npoints(density(x[-inA]), type = \"l\", col = 4)\nrug(x[-inA], col = 4)\n\ncreateResample(oilType, 2)\n\ncreateFolds(oilType, 10)\ncreateFolds(oilType, 5, FALSE)\n\ncreateFolds(rnorm(21))\n\ncreateTimeSlices(1:9, 5, 1, fixedWindow = FALSE)\ncreateTimeSlices(1:9, 5, 1, fixedWindow = TRUE)\ncreateTimeSlices(1:9, 5, 3, fixedWindow = TRUE)\ncreateTimeSlices(1:9, 5, 3, fixedWindow = FALSE)\n\ncreateTimeSlices(1:15, 5, 3)\ncreateTimeSlices(1:15, 5, 3, skip = 2)\ncreateTimeSlices(1:15, 5, 3, skip = 3)\n\nset.seed(131)\ngroups <- sort(sample(letters[1:4], size = 20, replace = TRUE))\ntable(groups)\nfolds <- groupKFold(groups)\nlapply(folds, function(x, y) table(y[x]), y = groups)\n\n# calls recorded from these examples and this script:\ncreateDataPartition(oilType, 2)\ncreateDataPartition(x, list = FALSE)\ncreateDataPartition(y = Sonar$Class, p = 0.75, list = FALSE)"}