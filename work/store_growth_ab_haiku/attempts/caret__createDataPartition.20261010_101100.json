if np.any(counts == 1):\n            # Warning about singleton classes (we just note but continue)\n            pass\n    \n    # Create data frame with y and index (1-based like R)\n    df = pd.DataFrame({\n        'y': y,\n        'index': np.arange(1, len(y) + 1)\n    })\n    \n    out = []\n    \n    for j in range(times):\n        # Group by y and sample from each group\n        sampled_indices = []\n        \n        for group_val in df['y'].unique():\n            group_df = df[df['y'] == group_val]\n            group_indices = group_df['index'].values\n            \n            if len(group_df) == 1:\n                # If only one item in group, always select it\n                num = 1\n            else:\n                # Sample ceiling(n * p) items\n                num = int(np.ceil(len(group_df) * p))\n            \n            # Sample without replacement\n            sampled = np.random.choice(group_indices, size=num, replace=False)\n            sampled_indices.extend(sampled)\n        \n        # Sort the combined indices\n        sampled_indices = np.sort(np.array(sampled_indices))\n        out.append(sampled_indices)\n    \n    if not list:\n        # Return as matrix (each column is a resample)\n        # Pad to same length if needed\n        max_len = max(len(x) for x in out)\n        matrix = np.full((max_len, times), np.nan)\n        for i, indices in enumerate(out):\n            matrix[:len(indices), i] = indices\n        \n        # Create column names like \"Resample1\", \"Resample2\", etc.\n        col_names = [f\"Resample{i+1}\" for i in range(times)]\n        \n        # Return as numpy array (the test harness will handle column names)\n        return matrix\n    else:\n        # Return as list with names\n        return out\n", "failures": [{"call": "createDataPartition(y = Sonar$Class, p = 0.75, list = FALSE)", "expected": [[1], [2], [3], [4], [5], [7], [10], [11], [12], [13], [14], [16], [17], [18], [19], [20], [21], [22], [23], [24], [2